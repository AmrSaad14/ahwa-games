# The game lives under https://DOMAIN/boardbattles (the app, the sign-in pages, the API, the WebSocket at
# /boardbattles/ws); the prefix is taken off before the game server sees the request.
{$DOMAIN} {
	# the web build's files are already Brotli: sent as they are, with their size (the loading bar needs it)
	@compressible not path /boardbattles/Build/*
	encode @compressible zstd gzip
	handle_path /boardbattles/* {
		# the game in the browser (the Unity web build, put in /opt/board-battles/web by unity-web.yml): its page
		# and files; everything else (the API, sign-in, the live connection, the legal pages) is the game server
		root * /srv/web
		@page {
			path /
			file {
				root /srv/web
				try_files /index.html
			}
		}
		@files {
			path /Build/* /StreamingAssets/* /icon.png /icon-192.png /logo.png /share.jpg /manifest.webmanifest /sw.js
			file {
				root /srv/web
			}
		}
		@br path *.br
		header @br Content-Encoding br
		@wasm path *.wasm.br
		header @wasm Content-Type application/wasm
		@js path *.js.br
		header @js Content-Type application/javascript
		@data path *.data.br *.symbols.json.br
		header @data Content-Type application/octet-stream
		header @page Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		handle @page {
			file_server
		}
		handle @files {
			file_server
		}
		handle {
			reverse_proxy domino:8080
		}
	}
	handle /boardbattles {
		redir * /boardbattles/ 308
	}
	# the web version's live connection (it connects to /ws on the page's own host)
	handle /ws {
		reverse_proxy domino:8080
	}
	# anything else on the domain (a page's own links such as /privacy, /admin) is the game's too
	handle {
		redir * /boardbattles{uri} 308
	}
}

# the server's old address: everything at the root, as before (apps from before the domain connect here)
{$OLD_DOMAIN:static.22.157.225.46.clients.your-server.de} {
	encode zstd gzip
	reverse_proxy domino:8080
}

# the server's own address over plain http, for checking it before the domain points here
http://{$SERVER_IP:127.0.0.1} {
	reverse_proxy domino:8080
}
