# Your domain, pointed at this server's IP with an A record. Caddy gets the HTTPS certificate automatically.
DOMAIN=ahwa-games.a7medhussien.com

# Signs player sessions. Leave empty to let the server generate one and keep it in the database.
SECRET=

# Voice chat relay (TURN). Any long random string; the game server and the relay share it.
# Generate one with:  openssl rand -hex 32
TURN_SECRET=

# The password for the dashboard at https://DOMAIN/admin (a long random one; leave empty to turn the dashboard off).
ADMIN_KEY=
# Cash-out to Vodafone Cash at first start (after that, switch it in the dashboard).
CASHOUT_ENABLED=0

# Gameplay timing
TURN_SECONDS=10
BOT_FILL_SECONDS=8
# CHESS_MINUTES=5   # uncomment to force one clock length for every chess mode
NEXT_ROUND_SECONDS=7

# --- Sign-in (README → Sign-in with Google and a mobile number) ---
# Google: an OAuth "Web application" client whose redirect URI is https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile number: twilio (Twilio Verify), http (your own SMS gateway) or console (codes in the server log, for testing)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# --- Rewarded ads (README → Ads) ---
# 1 once AdMob's server-side verification is set to https://<DOMAIN>/ads/ssv (then only Google-confirmed views pay)
ADS_SSV=

# --- Sign in with Apple (README → Sign in with Apple); return URL https://<DOMAIN>/auth/apple/callback ---
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# the .p8 key's text, on one line with \n for the line breaks
APPLE_PRIVATE_KEY=

# --- Google Play purchases (README → Shop): the service account's JSON key, on one line (or base64) ---
GOOGLE_PLAY_SERVICE_ACCOUNT=

# --- Push reminders (README → Push reminders): the Firebase service account's JSON key, on one line (or base64) ---
FIREBASE_SERVICE_ACCOUNT=

# --- Support messages by e-mail (optional; they are always kept at /admin/support?key=ADMIN_KEY) ---
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- The weekly tournament: day (0 Sunday … 4 Thursday) and hour, Cairo time ---
TOURNEY_WEEKDAY=4
TOURNEY_HOUR=21
