# Your domain, pointed at this server's IP with an A record. Caddy gets the HTTPS certificate automatically.
DOMAIN=domino.example.com

# Signs player sessions. Leave empty to let the server generate one and keep it in the database.
SECRET=

# Voice chat relay (TURN). Any long random string; the game server and the relay share it.
# Generate one with:  openssl rand -hex 32
TURN_SECRET=

# Lets you read player reports at https://DOMAIN/api/admin/reports?key=ADMIN_KEY (leave empty to turn this off).
ADMIN_KEY=

# Gameplay timing
TURN_SECONDS=10
BOT_FILL_SECONDS=12
# CHESS_MINUTES=5   # uncomment to force one clock length for every chess mode
NEXT_ROUND_SECONDS=7
