{
  "name": "ahwa-domino",
  "version": "1.0.0",
  "private": true,
  "description": "Online multiplayer domino, tawla, chess and ludo at a 3D coffeehouse table. Node game server + web/Android/iOS client.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "node scripts/build-client.mjs --watch",
    "build": "node scripts/build-client.mjs && node scripts/build-server.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --no-warnings=ExperimentalWarning dist/server.cjs",
    "test": "tsx --test --test-concurrency=1 tests/engine.test.ts tests/games.test.ts tests/server.test.ts tests/features.test.ts tests/api.test.ts tests/i18n.test.ts tests/backup.test.ts tests/billing.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cap:android": "npm run build:client && cap sync android && cap open android",
    "cap:ios": "npm run build:client && cap sync ios && cap open ios",
    "cap:assets": "capacitor-assets generate --assetPath resources",
    "cap:permissions": "node scripts/native-permissions.mjs",
    "howto": "node scripts/record-howto.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "devDependencies": {
    "@capacitor-community/admob": "6.2.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/share": "^6.0.2",
    "@types/node": "^22.9.0",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "three": "0.160.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
