 "lines": [
  {
   "id": "f1",
   "who": "father",
   "before": 0.8,
   "text": "قبل ما نتكلم في الشبكة، هتلاعبني."
  },
  {
   "id": "g1",
   "who": "groom",
   "before": 0.25,
   "text": "أ، ألاعب حضرتك؟"
  },
  {
   "id": "g2",
   "who": "groom",
   "before": 0.6,
   "text": "طب ما نلعب أونلاين يا عمي؟ كل واحد يختار لعبته."
  },
  {
   "id": "f2",
   "who": "father",
   "before": 0.45,
   "text": "هات. طاولة."
  },
  {
   "id": "f3",
   "who": "father",
   "before": 1.2,
   "text": "دُش! اتفضل، ارجع بيتكم."
  },
  {
   "id": "g3",
   "who": "groom",
   "before": 0.3,
   "text": "لا لا، دومينو. دي بتاعتي."
  },
  {
   "id": "g4",
   "who": "groom",
   "before": 1.25,
   "text": "قفلت يا عمي."
  },
  {
   "id": "m1",
   "who": "mother",
   "before": 1.8,
   "text": "معلش يا حاج، أكلتك. وانت كمان يا مروان."
  },
  {
   "id": "b1",
   "who": "bride",
   "before": 1.1,
   "text": "كش ملك يا بابا."
  },
  {
   "id": "f4",
   "who": "father",
   "before": 1.1,
   "text": "هو انتو كلكو معاه؟!"
  },
  {
   "id": "f5",
   "who": "father",
   "before": 1.6,
   "text": "اصحى! الماتش الفاصل."
  },
  {
   "id": "g5",
   "who": "groom",
   "before": 0.35,
   "text": "يا عمي، أنا جاي أخطب بنتك، ولا أخطبك انت؟"
  },
  {
   "id": "vo",
   "who": "father",
   "before": 1.0,
   "after": 1.2,
   "text": "بورد باتلز، نزّلها ببلاش، واللي يكسب يتكلم."
  }
 ]
